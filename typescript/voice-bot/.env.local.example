# The StreamCore server's WHIP endpoint.
NEXT_PUBLIC_WHIP_URL=http://localhost:8080/whip

# Only needed if the server has auth turned on — that is, if its config.toml
# sets `jwt_secret`. Leave both blank against a default server, which allows
# unauthenticated connections; fill them in and the SDK fetches a short-lived
# JWT before every connect.
#
#   NEXT_PUBLIC_TOKEN_URL=http://localhost:8080/token
#   NEXT_PUBLIC_API_KEY=<the server's api_key, if it sets one>
#
# Getting this wrong shows up as a 401 the moment you press connect.
NEXT_PUBLIC_TOKEN_URL=
NEXT_PUBLIC_API_KEY=
